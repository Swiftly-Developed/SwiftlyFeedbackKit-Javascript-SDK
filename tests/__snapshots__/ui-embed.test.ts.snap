exports[`large text (200%) > card markup 1`] = `"<li class="fk-item" data-fk-item="a"><article class="fk-card" part="card" aria-labelledby="fkN-title-a"><p class="fk-eyebrow" data-status="in_progress"><svg class="fk-status-glyph" data-status-glyph="in_progress" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M8 3.5a4.5 4.5 0 0 0 0 9z"></path></svg><span>In Progress</span></p><h3 class="fk-title" id="fkN-title-a">Offline sync</h3><p class="fk-description">Work without a connection.</p><div class="fk-footer"><div class="fk-facts"><span class="fk-fact" data-fk-fact="category"><svg class="fk-icon" data-icon="tune" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"></path></svg><span>Improvement</span></span><span class="fk-fact" data-fk-fact="comments"><svg class="fk-icon" data-icon="comment" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"></path></svg><span aria-hidden="true">3</span><span class="fk-sr-only">3 comments</span></span></div><button type="button" class="fk-vote" part="vote" aria-pressed="false" aria-label="42 votes" aria-describedby="fkN-vote-hint-a" data-fk-vote="votable" data-fk-action="vote" data-fk-id="a" data-fk-key="vote:a"><svg class="fk-icon" data-icon="arrowUp" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z"></path></svg><span aria-hidden="true">42</span></button><span class="fk-sr-only" id="fkN-vote-hint-a">Adds your vote</span></div></article></li><li class="fk-item" data-fk-item="c"><article class="fk-card" part="card" aria-labelledby="fkN-title-c"><p class="fk-eyebrow" data-status="completed"><svg class="fk-status-glyph" data-status-glyph="completed" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="7"></circle><path class="fk-glyph-cut" d="M4.8 8.2 7 10.4l4.2-4.4" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Completed</span></p><h3 class="fk-title" id="fkN-title-c">Widgets</h3><p class="fk-description">Home screen widgets.</p><div class="fk-footer"><div class="fk-facts"><span class="fk-fact" data-fk-fact="category"><svg class="fk-icon" data-icon="lightbulb" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7zm2.85 11.1-.85.6V16h-4v-2.3l-.85-.6C7.8 12.16 7 10.63 7 9c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.63-.8 3.16-2.15 4.1z"></path></svg><span>Feature Request</span></span><span class="fk-fact" data-fk-fact="comments"><svg class="fk-icon" data-icon="comment" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"></path></svg><span aria-hidden="true">1</span><span class="fk-sr-only">1 comment</span></span></div><span class="fk-vote-closed" data-fk-vote="closed" part="vote"><svg class="fk-icon" data-icon="arrowUp" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z"></path></svg><span aria-hidden="true">1</span><span class="fk-sr-only">1 vote, Voting is closed</span></span></div></article></li>"`;

exports[`large text (200%) > filtered header and open menu markup 1`] = `"<div class="fk-header"><h2 class="fk-heading" id="fkN-heading">Feedback</h2><div class="fk-menu-anchor"><button type="button" class="fk-btn fk-btn-filled" part="menu-button" id="fkN-menu-button" aria-haspopup="menu" aria-expanded="true" aria-controls="fkN-menu" aria-describedby="fkN-menu-value" data-fk-action="menu-toggle" data-fk-key="menu-button" data-active="true"><svg class="fk-icon" data-icon="filterActive" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M12 1a11 11 0 1 1 0 22 11 11 0 0 1 0-22zM6 7.5v2h12v-2H6zm2 3.5v2h8v-2H8zm2 3.5v2h4v-2h-4z"></path></svg><span>Sort &amp; Filter</span></button><span class="fk-sr-only" id="fkN-menu-value">Filtered by Improvements</span><div role="menu" class="fk-menu" id="fkN-menu" aria-labelledby="fkN-menu-button" part="menu"><div class="fk-menu-heading" aria-hidden="true">Sort By</div><div role="group" class="fk-menu-group" aria-label="Sort By"><button type="button" role="menuitemradio" class="fk-menu-item" tabindex="0" aria-checked="true" data-fk-action="sort" data-fk-value="votes" data-fk-key="sort:votes"><span class="fk-menu-check"><svg class="fk-icon" data-icon="check" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path></svg></span><span class="fk-menu-label">Most Votes</span></button><button type="button" role="menuitemradio" class="fk-menu-item" tabindex="-1" aria-checked="false" data-fk-action="sort" data-fk-value="newest" data-fk-key="sort:newest"><span class="fk-menu-check"><svg class="fk-icon" data-icon="check" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path></svg></span><span class="fk-menu-label">Newest</span></button><button type="button" role="menuitemradio" class="fk-menu-item" tabindex="-1" ari